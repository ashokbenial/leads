# LeadForge 360 — environment template.
# Copy to .env.local and fill in:   cp .env.example .env.local
# NEVER put production credentials in .env.local.

# ---- Supabase (required — the server refuses to boot without both) ----
# Use the DEV project (leadforge-dev). A PROD url on a dev machine replaces the
# live production workspace on the first write.
SUPABASE_URL=https://<project-ref>.supabase.co

# Dashboard -> Project Settings -> API Keys -> Secret keys.
# Must be the SECRET key (sb_secret_...). A publishable key is rejected at boot:
# leadforge_state has RLS on with no policies, so a publishable key returns an
# EMPTY workspace behind a green /api/health — and the first write overwrites prod.
SUPABASE_SECRET_KEY=sb_secret_...

# ---- Authentication (required to enable privileged scoring operations) ----
# 32+ random bytes. Signs session tokens (HMAC-SHA256) issued by /api/auth/login.
# WITHOUT it: scoring reads work anonymously as Viewer, and every scoring
# MUTATION is refused with 503. Request headers are never trusted for identity.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# Session lifetime in hours (default 12).
# SESSION_HOURS=12

# ---- Optional ----
# Local API port. Ignored on Vercel.
PORT=4000

# Shared secret for the website ingest webhooks
# (/api/subvendors/ingest, /api/partners/ingest, /api/jobs/ingest).
# Unset => those endpoints are UNAUTHENTICATED. Always set it in production.
# INGEST_TOKEN=

# First-run Admin. Seeded only when the database has no Admin with credentials.
# SEED_ADMIN_EMAIL=admin@ab7solutions.com
# SEED_ADMIN_PASSWORD=ChangeMe@AB7
