{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "LeadForge 360 — API server (.env.local)",
      "program": "${workspaceFolder}/db-server.js",
      "runtimeArgs": ["--env-file-if-exists=.env.local"],
      "cwd": "${workspaceFolder}",
